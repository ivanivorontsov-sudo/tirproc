{
  "name": "tirproc",
  "productName": "Тирпроц",
  "version": "1.3.0",
  "description": "Офлайн-редактор тир-листов",
  "main": "main.js",
  "author": "Иван Воронцов",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.tirproc.app",
    "productName": "Тирпроц",
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "shortcutName": "Тирпроц",
      "artifactName": "Tirproc-Setup-${version}.exe"
    },
    "extraFiles": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ]
  }
}
