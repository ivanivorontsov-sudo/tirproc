{
  "name": "tirproc",
  "productName": "Тирпроц",
  "version": "1.0.7",
  "description": "Тирпроц со встроенным браузером DeepSeek",
  "main": "main.js",
  "author": "ivanivorontsov-sudo",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.tirproc.app",
    "productName": "Тирпроц",
    "directories": { "output": "dist" },
    "publish": null,
    "files": ["index.html", "styles.css", "app.js", "main.js", "preload.js", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Тирпроц",
      "artifactName": "Tirproc-Setup-${version}.exe"
    }
  }
}
